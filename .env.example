# ============================================================
# cloudflare-best-sstp 配置样例
# 复制为 .env 后填写。标注【必填】的项必须提供，其余留空即使用默认值。
# ============================================================

# ---------- 业务请求配置 ----------
# 登录密码【必填】——换取鉴权 Cookie
SSTP_PASSWORD=

# 登录地址
SSTP_LOGIN_URL=change-me
# 登录表单中的密码字段名
SSTP_PASSWORD_FIELD=password
# 鉴权 Cookie 名称
SSTP_AUTH_COOKIE_NAME=auth
# SSTP 节点订阅列表地址
SSTP_LIST_URL=change-me
# 单节点联通性检测地址
SSTP_CHECK_URL=change-me
# 请求 Referer 基地址
SSTP_REFERER=change-me
# 输出中展示的服务器主机名
SSTP_SERVER_HOST=change-me
# 输出行模板，占位符：{host} {loc} {proxy} {ip} {response_time}
SSTP_OUTPUT_TEMPLATE={host}#{loc}链式SSTP代理{proxy}

# ---------- HTTP / 代理 / 性能配置 ----------
# 代理地址，支持 http / https / socks5，例如：
#   http://127.0.0.1:7890
#   socks5://127.0.0.1:1080
# 留空则回退读取 ALL_PROXY / 系统代理环境变量
SSTP_PROXY=
# 请求超时（秒）
SSTP_TIMEOUT_SECS=30
# 连接超时（秒）
SSTP_CONNECT_TIMEOUT_SECS=15
# 瞬时错误（网络错误 / 5xx / 429）最大重试次数
SSTP_MAX_RETRIES=3
# 重试基准退避（毫秒，指数退避 base * 2^n）
SSTP_RETRY_BACKOFF_MS=500
# 节点检测并发度
SSTP_CONCURRENCY=16
# 自定义 User-Agent（留空用内置默认）
SSTP_USER_AGENT=

# ---------- 文件输出 ----------
# 是否写入本地文件
SSTP_OUTPUT_FILE_ENABLED=true
# 输出文件路径（容器内默认 /app/output/sstp.txt，已映射到宿主机 ./output）
OUTPUT_PATH=/app/output/sstp.txt

# ---------- GitHub 仓库同步（可选）----------
# 是否同步到 GitHub（true 时 TOKEN 与 REPO 为必填）
GITHUB_SYNC_ENABLED=false
# GitHub Personal Access Token（需 contents:write 权限）
GITHUB_TOKEN=
# 目标仓库 owner/repo
GITHUB_REPO=
# 目标分支
GITHUB_BRANCH=main
# 目标文件在仓库中的路径
GITHUB_FILE_PATH=sstp.txt
# 提交信息
GITHUB_COMMIT_MESSAGE=chore: update sstp nodes
# 提交作者（留空则使用 Token 对应账号）
GITHUB_AUTHOR_NAME=
GITHUB_AUTHOR_EMAIL=
# GitHub API Base（指向 GitHub Enterprise 时修改）
GITHUB_API_BASE=https://api.github.com

# ---------- 日志 ----------
# 日志级别：trace / debug / info / warn / error（或用 RUST_LOG 精细控制）
LOG_LEVEL=info
